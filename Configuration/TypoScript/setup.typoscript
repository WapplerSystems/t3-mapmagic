plugin.tx_mapmagic {
    view {
        templateRootPaths.0 = EXT:map_magic/Resources/Private/Frontend/Templates/
        partialRootPaths.0 = EXT:map_magic/Resources/Private/Frontend/Partials/
        layoutRootPaths.0 = EXT:map_magic/Resources/Private/Frontend/Layouts/
    }

    mvc {
        callDefaultActionIfActionCantBeResolved = 1
    }

    settings {
        yamlConfigurations {
            10 = EXT:map_magic/Configuration/Yaml/MapSetup.yaml
        }
    }
}
