

let {{ data.map.identifier }} = L.map('{{ data.map.identifier }}');

{% if data.map.properties.view.lat or data.map.properties.view.lng %}
     {{ data.map.identifier }}.setView([{{ data.map.properties.view.lat }}, {{ data.map.properties.view.lng }}], {{ data.map.properties.view.zoom }});
{% endif %}

{% for layer in data.map.layers %}

     {% include 'MapElements/' ~ layer.type~ '.twig' with {'layer': layer, 'map': data.map} %}

{% endfor %}

